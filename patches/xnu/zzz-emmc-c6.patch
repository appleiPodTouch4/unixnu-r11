# R11: publish the CMD6 HS_TIMING/BUS_WIDTH result, because irq66's reset did not move d1.
#
# boot-irq66's photo: PIO-only stayed alive, but LBA1 still read 4546492045464920 and
# EXT_CSD stayed rev0/sec0, exactly as irq65.  The hs0/bw1 stage lines were already
# scrolled out, so there is no evidence whether the card accepted HS_TIMING=0 /
# BUS_WIDTH=0 or returned SWITCH_ERROR.
#
# This patch stores for each CMD6:
#   (command error << 24) | (busy-timeout ? 0x800000 : 0) | (R1 & 0xffffff)
# and prints both on the EMMC2 row as c6=<hs>/<bw>.
#
# R1 bit 7 (0x80) is SWITCH_ERROR; low bits also carry the card state.  A command
# error in the high byte or the 0x800000 busy flag says the switch never completed.
# Everything else (PIO-only, HS reset order, warm CMD7 diagnostic) is unchanged.
diff --git a/bsd/dev/qcom_emmc.c b/bsd/dev/qcom_emmc.c
index 4d662f9..540e7c1 100644
--- a/bsd/dev/qcom_emmc.c
+++ b/bsd/dev/qcom_emmc.c
@@ -145,6 +145,9 @@ volatile unsigned int qcom_emmc_hc1_boot, qcom_emmc_clk_boot, qcom_emmc_ps_boot,
 /* boot-irq60: 1 after the boot-state read, 2 after CMD13, 3 when the warm ADMA2
  * LBA1 read delivered EFI PART and the driver kept the bootloader's state. */
 volatile unsigned int qcom_emmc_warm;
+/* boot-irq67: CMD6 HS_TIMING/BUS_WIDTH result: (error<<24) | busy-timeout(0x800000) |
+ * low 24 bits of the R1 response.  This says whether the card accepted the switch. */
+volatile unsigned int qcom_emmc_c6_hs, qcom_emmc_c6_bw;
 /* The DMA landing zone. One block (512 = EMMC_BLOCK below), page aligned so the CPU
  * physical address is guaranteed to cover 512 contiguous bytes of one page; the block
  * is bounced through it because a caller's buffer has no such guarantee. */
@@ -1467,13 +1470,17 @@ emmc_device_init(void)
 	 */
 	{
 		uint64_t busy;
+		uint32_t r1 = 0;
+		int busyto = 0;
 
 		error = emmc_cmd(6, 0x03b90000u, /* EXT_CSD[185] = 0, HS_TIMING default, R1b */
 		    SDHCI_CMD_RESP_R48B | SDHCI_CMD_CRC | SDHCI_CMD_INDEX, resp, NULL, 0);
+		r1 = resp[0];
 		if (!error) {
 			busy = timeout_ns(200ull * NSEC_PER_MSEC);
 			while (hc_rd(SDHCI_PRESENT_STATE) & SDHCI_DAT0_LOW) {
 				if (!wait_deadline(busy)) {
+					busyto = 1;
 					break;
 				}
 			}
@@ -1481,12 +1488,18 @@ emmc_device_init(void)
 		} else {
 			BP_STAGE("emmc: hs0 failed");
 		}
+		qcom_emmc_c6_hs = ((unsigned)(error & 0xff) << 24) |
+		    (r1 & 0xffffffu) | (busyto ? 0x800000u : 0u);
+
 		error = emmc_cmd(6, 0x03b70000u, /* EXT_CSD[183] = 0, 1-bit, R1b */
 		    SDHCI_CMD_RESP_R48B | SDHCI_CMD_CRC | SDHCI_CMD_INDEX, resp, NULL, 0);
+		r1 = resp[0];
+		busyto = 0;
 		if (!error) {
 			busy = timeout_ns(200ull * NSEC_PER_MSEC);
 			while (hc_rd(SDHCI_PRESENT_STATE) & SDHCI_DAT0_LOW) {
 				if (!wait_deadline(busy)) {
+					busyto = 1;
 					break;
 				}
 			}
@@ -1494,6 +1507,8 @@ emmc_device_init(void)
 		} else {
 			BP_STAGE("emmc: bw1 failed");
 		}
+		qcom_emmc_c6_bw = ((unsigned)(error & 0xff) << 24) |
+		    (r1 & 0xffffffu) | (busyto ? 0x800000u : 0u);
 	}
 
 	/*
