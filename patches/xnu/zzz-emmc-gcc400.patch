diff --git a/bsd/dev/qcom_emmc.c b/bsd/dev/qcom_emmc.c
index ed00e1d..be12512 100644
--- a/bsd/dev/qcom_emmc.c
+++ b/bsd/dev/qcom_emmc.c
@@ -450,9 +450,52 @@ emmc_clock_khz(void)
  * was off by a factor of four (and the same mistake was present in the data-phase
  * block count, which is what actually stopped the transfer).
  */
+/*
+ * boot-irq86: SDM660's SDCC has no internal clock divider; the card clock is the
+ * GCC sdcc1_apps_clk_src root.  clover proved the 400 kHz row:
+ * XO 19.2 MHz / 12 * 1/4, CFG=0x2017, M=1, N=0xfc, D=0xfb, at GCC+0x16000.
+ * Without this the host keeps the firmware's 200 MHz root and PIO/data is
+ * sampled at the wrong rate even though CMD1 answers.
+ */
+static int
+emmc_gcc_400k(void)
+{
+	const vm_offset_t gcc = ml_io_map(0x00100000, 0x20000);
+	if (!gcc) {
+		return -1;
+	}
+	/* Stop the card clock before touching its root. */
+	hc_wr16(SDHCI_CLOCK_CONTROL, 0);
+	for (unsigned i = 0; i < 10000; i++) {
+		if (!(hc_rd16(SDHCI_CLOCK_CONTROL) & 0x0005u)) {
+			break;
+		}
+	}
+	*(volatile uint32_t *)(gcc + 0x16004) |= 1u;
+	*(volatile uint32_t *)(gcc + 0x16008) |= 1u;
+	*(volatile uint32_t *)(gcc + 0x16034) =
+	    (*(volatile uint32_t *)(gcc + 0x16034) & ~0xffu) | 0x01u;
+	*(volatile uint32_t *)(gcc + 0x16038) =
+	    (*(volatile uint32_t *)(gcc + 0x16038) & ~0xffu) | 0xfcu;
+	*(volatile uint32_t *)(gcc + 0x1603c) =
+	    (*(volatile uint32_t *)(gcc + 0x1603c) & ~0xffu) | 0xfbu;
+	uint32_t cfg = *(volatile uint32_t *)(gcc + 0x16030);
+	*(volatile uint32_t *)(gcc + 0x16030) = (cfg & ~0x0010371fu) | 0x00002017u;
+	*(volatile uint32_t *)(gcc + 0x1602c) |= 1u;
+	for (unsigned i = 0; i < (1u << 16); i++) {
+		if (!(*(volatile uint32_t *)(gcc + 0x1602c) & 1u)) {
+			break;
+		}
+	}
+	return 0;
+}
+
 static void
 emmc_clock_set_rate(uint32_t khz)
 {
+	if (khz == 0 || khz == 400) {
+		(void)emmc_gcc_400k();
+	}
 	uint32_t base = su.base_mhz ? su.base_mhz * 1000u : 200000u;
 	uint64_t deadline = timeout_ns(100000ull * NSEC_PER_USEC);
 
@@ -1238,6 +1281,22 @@ emmc_device_init(void)
 	emmc_clock_set_rate(400);
 	BP_STAGE("emmc: clk 400k id");
 
+	/*
+	 * boot-irq86: CORE_VENDOR_SPEC3 bit 10 selects Qualcomm's alternative FIFO;
+	 * with it set the SDHCI buffer port returns the first word forever ("EFI EFI").
+	 * clover fixed the same stale-data symptom by clearing it once with no
+	 * transfer active.
+	 */
+	{
+		uint32_t v3 = hc_rd(0x250);
+		hc_wr(0x250, v3 & ~(1u << 10));
+		{
+			char line[64];
+			snprintf(line, sizeof(line), "emmc: v3 %08x->%08x", v3, hc_rd(0x250));
+			BP_STAGE(line);
+		}
+	}
+
 	/* Power: 1.8 V signalling, bus on. QCom v5 may ignore this. */
 	hc_wr8(SDHCI_HOST_CONTROL + 1, 0x0bu);
 
