+/*
+ * boot-irq60: one 512-byte block through the bootloader's ADMA2 engine.
+ *
+ * boot-irq59's photo showed the bootloader left HC1=0x38 (8-bit + ADMA64),
+ * clock=0x0007 (~100 MHz) and CORE_VENDOR_SPEC=0x240a0e (HS400 select-in/DLL).
+ * irq58 tried that state with SDMA and a DAT reset; this helper keeps the engine
+ * and bus exactly as found: it does not write HC1, the clock or the vendor
+ * registers, does not reset DAT, and uses a 16-byte ADMA2 descriptor next to the
+ * page-aligned data buffer -- the layout E5's admaRead512() uses.
+ */
+static int
+emmc_adma_read(uint32_t idx, uint32_t arg, uint8_t *out)
+{
+	volatile uint32_t *desc = (volatile uint32_t *)(void *)(emmc_dma_buf + 512);
+	uint64_t deadline = timeout_ns(CMD_TIMEOUT_NS);
+	uint32_t phys, dphys;
+	uint16_t status;
+	int error;
+
+	bzero(emmc_dma_buf, 512);
+	phys = (uint32_t)ml_static_vtop((vm_offset_t)(uintptr_t)emmc_dma_buf);
+	dphys = phys + 512;
+	desc[0] = 0x23u | (512u << 16);	/* Valid|End|Transfer, length 512 */
+	desc[1] = phys;
+	desc[2] = 0;
+	desc[3] = 0;
+	/* Clean data+descriptor out so the engine sees what the CPU wrote. */
+	FlushPoC_DcacheRegion((vm_offset_t)(uintptr_t)emmc_dma_buf, sizeof(emmc_dma_buf));
+
+	qcom_emmc_lasterr = 0xE0u;
+	error = emmc_wait(SDHCI_CMD_INHIBIT, 0, deadline);
+	if (error) {
+		return error;
+	}
+	qcom_emmc_lasterr = 0xE1u;
+	error = emmc_wait(SDHCI_DATA_INHIBIT, 0, deadline);
+	if (error) {
+		return error;
+	}
+	hc_wr16(SDHCI_INT_STATUS, 0xffffu);
+	hc_wr16(SDHCI_BLOCK_SIZE, EMMC_BLOCK);
+	if (su.v4) {
+		hc_wr(SDHCI_DMA_ADDRESS, 1);
+	} else {
+		hc_wr16(SDHCI_BLOCK_COUNT, 1);
+	}
+	qcom_emmc_bs = hc_rd16(SDHCI_BLOCK_SIZE);
+	qcom_emmc_bc = su.v4 ? hc_rd(SDHCI_DMA_ADDRESS) : hc_rd16(SDHCI_BLOCK_COUNT);
+	hc_wr(SDHCI_ADMA_ADDRESS, dphys);
+	hc_wr(SDHCI_ADMA_ADDRESS_HI, 0);
+	hc_wr16(SDHCI_TRANSFER_MODE, SDHCI_TM_DMA_EN | SDHCI_TM_READ |
+	    SDHCI_TM_BLKCNT_EN);
+	hc_wr(SDHCI_ARGUMENT, arg);
+	hc_wr16(SDHCI_COMMAND, SDHCI_CMD(idx,
+	    SDHCI_CMD_RESP_R48 | SDHCI_CMD_CRC | SDHCI_CMD_INDEX | SDHCI_CMD_DATA));
+	qcom_emmc_lasterr = 0xE2u;
+	error = emmc_wait_int(SDHCI_INT_CMD_COMPLETE, deadline, 1);
+	if (error) {
+		goto done;
+	}
+	qcom_emmc_lasterr = 0xE3u;
+	error = emmc_wait_int(SDHCI_INT_TX_COMPLETE | SDHCI_INT_DMA, deadline, 1);
+done:
+	status = hc_rd16(SDHCI_INT_STATUS);
+	qcom_emmc_dmaerr = ((unsigned)hc_rd16(SDHCI_ERR_INT_STATUS) << 16) | status;
+	hc_wr16(SDHCI_ERR_INT_STATUS, hc_rd16(SDHCI_ERR_INT_STATUS));
+	hc_wr16(SDHCI_INT_STATUS, 0xffffu);
+	FlushPoC_DcacheRegion((vm_offset_t)(uintptr_t)emmc_dma_buf, sizeof(emmc_dma_buf));
+	memcpy(out, emmc_dma_buf, EMMC_BLOCK);
+	return error;
+}
