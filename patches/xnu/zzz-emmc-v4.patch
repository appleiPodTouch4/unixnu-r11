 	hc_wr16(SDHCI_TRANSFER_MODE, SDHCI_TM_DMA_EN | SDHCI_TM_READ |
 	    SDHCI_TM_BLKCNT_EN);
 	hc_wr(SDHCI_ARGUMENT, arg);
@@ -565,9 +657,19 @@ emmc_cmd(unsigned idx, uint32_t arg, uint16_t flags, uint32_t *resp,
 			return error;
 		}
 		hc_wr16(SDHCI_BLOCK_SIZE, EMMC_BLOCK);
-		hc_wr16(SDHCI_BLOCK_COUNT, (uint16_t)blocks);
+		/*
