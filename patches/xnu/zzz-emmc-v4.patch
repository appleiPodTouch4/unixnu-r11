+ * layout (32-bit block count at 0x00, 64-bit system address at 0x58/0x5c). */
+#define SDHCI_HOST_CONTROL2    0x3e
+#define SDHCI_HC2_V4EN         0x1000u
+#define SDHCI_HC2_64BIT        0x2000u
+#define SDHCI_HC_DMA_MASK      0x18u
 #define SDHCI_CLOCK_CONTROL    0x2c
 #define SDHCI_TIMEOUT_CONTROL  0x2e
 #define SDHCI_SOFTWARE_RESET   0x2f
