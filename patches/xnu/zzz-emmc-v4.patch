# R11: drive the eMMC host as SDHCI 4.x (V4EN + 64-bit addressing), ported from E5.
#
# The UniXNU-e5 port (Enceka/UniXNU-e5) does exactly what this driver could not:
# its NativeEmmc reads LBA0/LBA1, validates the GPT and publishes all 70 partitions
# on an eMMC host of the same generation.  Its source documents the failure class
# this port was stuck in:
#
#   * an SDHCI 4.x host has HC2 (0x3e) V4EN set, and then the 32-bit block count
#     lives at 0x00 while the system address lives at 0x58/0x5c.  This driver wrote
#     the v3 16-bit count at 0x06 and the v3 system address at 0x00, so the real
#     count at 0x00 stayed zero: the controller reported a data phase that never
#     moved a block and the buffer port returned its previous word, which is the
#     "EFI EFI " (0x4546492045464920) every earlier image saw.
#   * the DMA select in Host Control 1 must be SDMA (bits 4:3 = 00).  If the
#     bootloader left ADMA2 selected, writing a data address into 0x58 makes the
#     controller read the data buffer as an ADMA2 descriptor table.
#   * the clock divider changes shape: v3 has an 8-bit field at 15:8, v4 has a
#     10-bit field at 15:6.  The old "400 kHz" arithmetic was therefore wrong on a
#     v4 host as well.
#
# The validated E5 path also never issues CMD6: it re-identifies in 1-bit default
# speed and reads the whole GPT that way.  This patch does the same, so the GPT
# scan uses the bus configuration that just delivered EXT_CSD.
#
# Changes:
#   - program HC2 = V4EN|64BIT, read it back, and record hc1/hc2/hc2_boot/v4 for
#     the panel;
#   - Host Control 1 = 0 (1-bit, SDMA select);
#   - emmc_clock_set_rate(kHz): v4 10-bit divider, v3 8-bit fallback;
#   - block count at 0x00 (32-bit) on v4, system address at 0x58/0x5c;
#   - emmc_sdma_read() selects SDMA and uses the same layout;
#   - drop the CMD6 8-bit/HS switch (E5 keeps 1-bit default speed).
diff --git a/bsd/dev/qcom_emmc.c b/bsd/dev/qcom_emmc.c
index 6404163..11ad764 100644
--- a/bsd/dev/qcom_emmc.c
+++ b/bsd/dev/qcom_emmc.c
@@ -121,6 +121,17 @@ volatile unsigned int qcom_emmc_bs, qcom_emmc_bc, qcom_emmc_dat, qcom_emmc_sdm;
 volatile unsigned long long qcom_emmc_d2q;
 volatile unsigned int qcom_emmc_r2, qcom_emmc_sdma_phys, qcom_emmc_sdma_ok,
     qcom_emmc_dmaerr, qcom_emmc_st13;
+/*
+ * boot-irq57: the host-controller layout. E5's NativeEmmc (UniXNU-e5) proves the
+ * class of failure this driver hit: an SDHCI v4 host (HC2 V4EN=1) keeps the 32-bit
+ * block count at 0x00 and the system address at 0x58/0x5c, while this driver wrote
+ * the v3 count at 0x06 and the v3 system address at 0x00.  With V4EN=1 the count at
+ * 0x00 stays zero, the controller reports a transfer that never moved data, and the
+ * buffer port hands back its previous word -- exactly "EFI EFI ".  hc2_boot is the
+ * value the bootloader left, hc2 the value after this driver programmed it, hc1 the
+ * Host Control 1 (DMA select / bus width), v4 whether V4EN stuck.
+ */
+volatile unsigned int qcom_emmc_hc1, qcom_emmc_hc2, qcom_emmc_hc2_boot, qcom_emmc_v4;
 /* The DMA landing zone. One block (512 = EMMC_BLOCK below), page aligned so the CPU
  * physical address is guaranteed to cover 512 contiguous bytes of one page; the block
  * is bounced through it because a caller's buffer has no such guarantee. */
@@ -156,6 +167,12 @@ extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
 #define SDHCI_BUF_READ_EN      0x0800u
 #define SDHCI_PRESENT_STATE    0x24
 #define SDHCI_HOST_CONTROL     0x28
