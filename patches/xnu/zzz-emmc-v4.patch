+		 * register at 0x00; 0x06 is the v3 count and is ignored there. This
+		 * single difference is what left the real count at zero and made the
+		 * controller complete a transfer that never moved the block.
+		 */
+		if (su.v4) {
+			hc_wr(SDHCI_DMA_ADDRESS, blocks);
+		} else {
+			hc_wr16(SDHCI_BLOCK_COUNT, (uint16_t)blocks);
+		}
 		qcom_emmc_bs = hc_rd16(SDHCI_BLOCK_SIZE);
-		qcom_emmc_bc = hc_rd16(SDHCI_BLOCK_COUNT);
+		qcom_emmc_bc = su.v4 ? hc_rd(SDHCI_DMA_ADDRESS) : hc_rd16(SDHCI_BLOCK_COUNT);
 		hc_wr16(SDHCI_TRANSFER_MODE,
 		    (uint16_t)(SDHCI_TM_READ | SDHCI_TM_BLKCNT_EN |
 		    (blocks > 1 ? SDHCI_TM_MULTI | SDHCI_TM_AUTO_CMD12 : 0)));
@@ -798,6 +900,9 @@ emmc_device_init(void)
