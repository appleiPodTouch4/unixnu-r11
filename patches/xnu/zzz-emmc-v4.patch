 static uint32_t
 emmc_clock_khz(void)
 {
+	if (su.clock_khz) {
+		return su.clock_khz;
+	}
 	uint32_t base = su.base_mhz * 1000u;
 	uint32_t div = su.clock_div ? su.clock_div * 2u : 2u;
 
 	return div ? base / div : 0;
 }
 
+/*
+ * boot-irq57: set a rate in kHz, in whichever divider layout the host uses.
+ *
+ * SDHCI 3.x has an 8-bit divider at bits 15:8, SDCLK = base / (2 * (field + 1)).
+ * SDHCI 4.x with V4EN has a 10-bit divider at bits 15:6, SDCLK = base / (2 * div).
+ * The old code always wrote the v3 field, so on a v4 host every "400 kHz" request
+ * was off by a factor of four (and the same mistake was present in the data-phase
+ * block count, which is what actually stopped the transfer).
+ */
+static void
+emmc_clock_set_rate(uint32_t khz)
+{
+	uint32_t base = su.base_mhz ? su.base_mhz * 1000u : 200000u;
+	uint64_t deadline = timeout_ns(100000ull * NSEC_PER_USEC);
+
+	if (!khz) {
+		khz = 400;
+	}
+	if (su.v4) {
+		uint32_t div = base / (2u * khz);
+		uint16_t v;
+
+		if (div < 1) {
+			div = 1;
+		}
+		if (div > 0x3ffu) {
+			div = 0x3ffu;
+		}
+		v = (uint16_t)((div << 6) | 0x1u);	/* internal clock on */
+		hc_wr16(SDHCI_CLOCK_CONTROL, v);
+		while (!(hc_rd16(SDHCI_CLOCK_CONTROL) & 0x0002u)) {
+			if (!wait_deadline(deadline)) {
+				BP_STAGE("emmc: clk unstable");
+				return;
+			}
+		}
+		hc_wr16(SDHCI_CLOCK_CONTROL, (uint16_t)(v | 0x4u));	/* SD clock on */
+		delay(2000);
+		su.clock_khz = div ? base / (2u * div) : 0;
+		su.clock_div = 0;
+	} else {
+		uint32_t field = base / (2u * khz);
+
+		if (field) {
+			field--;
+		}
+		if (field > 0xffu) {
+			field = 0xffu;
+		}
+		emmc_clock_set(field);
+		su.clock_khz = base / (2u * (field + 1u));
+	}
+}
