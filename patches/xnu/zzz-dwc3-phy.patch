+/* R11 SDM660 QUSB2 PHY at 0xc012000, init sequence from the stock DTS
+ * qcom,qusb-phy-init-seq.  The firmware usually leaves the PHY powered; this
+ * replays the PHY register sequence because UEFI may stop its own USB stack at
+ * ExitBootServices.  Clocks/resets/GDSC are not touched here. */
+static void qusb2_phy_init(void)
+{
+    static const uint8_t seq[] = {
+        0xf8, 0x80, 0x83, 0x84, 0x83, 0x88, 0xc5, 0x8c,
+        0x30, 0x08, 0x79, 0x0c, 0x21, 0x10, 0x14, 0x9c,
+        0x9f, 0x1c, 0x00, 0x18
+    };
+    for (unsigned i = 0; i + 1 < sizeof(seq); i += 2) {
+        *(volatile uint8_t *)(phy_registers + seq[i]) = seq[i + 1];
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    unixnu_dwc3_phy_seq = 1;
+}
