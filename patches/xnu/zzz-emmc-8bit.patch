# R11: HS_TIMING=0 only; keep the card and host 8-bit, skip BUS_WIDTH.
#
# boot-irq68's c6 showed the HS_TIMING CMD6 succeeded cleanly (c6 first value
# 00000900: error 0, no busy flag, R1 Transfer), but the BUS_WIDTH CMD6 that followed
# held/left the controller in CMD inhibit, init returned 60 and no data ran
# (bs=bc=0).  The card was 8-bit from the bootloader; switching it to 1-bit while the
# host had already been set to 1-bit is the step that wedged.
#
# This patch:
#   - still does CMD6 EXT_CSD[185]=0 (HS_TIMING default), 2 s R1b wait, stop on busy;
#   - drops the EXT_CSD[183] BUS_WIDTH command entirely;
#   - sets host HC1 to 8-bit (0x20) to match the card;
#   - then runs the existing PIO LBA1 / MBR / EXT_CSD reads at 400 kHz.
#
# c6_bw stays 0.  If the card is default-speed 8-bit and the host is 8-bit, PIO should
# finally deliver EFI PART; if it still reads stale, the remaining issue is host-side.
diff --git a/bsd/dev/qcom_emmc.c b/bsd/dev/qcom_emmc.c
index d2c9b92..3077a47 100644
--- a/bsd/dev/qcom_emmc.c
+++ b/bsd/dev/qcom_emmc.c
@@ -1464,9 +1464,7 @@ emmc_device_init(void)
 	 * boot-irq66: force the card out of HS400 before any data read.  irq65's
 	 * PIO-only path was stable (no black) but LBA1 still read "EFI EFI " and
 	 * EXT_CSD came back as rev 0/sec 0: the card kept the bootloader's HS400
-	 * timing while the host was switched to 1-bit default speed.  Clear
-	 * HS_TIMING first and BUS_WIDTH second -- the opposite order of irq55's
-	 * width-only switch, which left an invalid HS400-on-1-bit state.
+	 * timing.  Clear HS_TIMING only; the card stays 8-bit, matching the host.
 	 */
 	{
 		uint64_t busy;
@@ -1497,29 +1495,17 @@ emmc_device_init(void)
 			return ETIMEDOUT;
 		}
 
-		error = emmc_cmd(6, 0x03b70000u, /* EXT_CSD[183] = 0, 1-bit, R1b */
-		    SDHCI_CMD_RESP_R48B | SDHCI_CMD_CRC | SDHCI_CMD_INDEX, resp, NULL, 0);
-		r1 = resp[0];
-		busyto = 0;
-		if (!error) {
-			busy = timeout_ns(2000ull * NSEC_PER_MSEC);
-			while (hc_rd(SDHCI_PRESENT_STATE) & SDHCI_DAT0_LOW) {
-				if (!wait_deadline(busy)) {
-					busyto = 1;
-					break;
-				}
-			}
-			BP_STAGE("emmc: bw1 ok");
-		} else {
-			BP_STAGE("emmc: bw1 failed");
-		}
-		qcom_emmc_c6_bw = ((unsigned)(error & 0xff) << 24) |
-		    (r1 & 0xffffffu) | (busyto ? 0x800000u : 0u);
-		if (busyto) {
-			BP_STAGE("emmc: bw1 busy");
-			return ETIMEDOUT;
-		}
-		delay(1000);	/* let the switch settle before the first data command */
+		/*
+		 * boot-irq69: HS_TIMING=0 is enough.  The card is 8-bit from the
+		 * bootloader, so keep the host 8-bit and skip the BUS_WIDTH switch that
+		 * irq68 timed out on (and left CMD inhibit set).  PIO never needed
+		 * 1-bit; the card is now default speed on an 8-bit bus.
+		 */
+		hc_wr8(SDHCI_HOST_CONTROL,
+		    (uint8_t)((hc_rd8(SDHCI_HOST_CONTROL) & ~SDHCI_HC_DMA_MASK) |
+		    SDHCI_HC_WIDTH_8));
+		qcom_emmc_c6_bw = 0;
+		delay(1000);	/* let the timing switch settle before the first data command */
 	}
 
 	/*
