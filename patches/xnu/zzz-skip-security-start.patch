+			    kOSKextLogLoadFlag,
+			    "R11: security extension %s start skipped (mode %d).",
+			    getIdentifierCString(), r11_skip_security_mode());
+			result = kOSKextReturnStartStopError;
+		} else {
+			result = startfunc(kmod_info, kmodStartData);
+		}
 	}
 
