# R11: read the LBA-1 block with SDMA, and publish why PIO only ever saw one word.
#
# boot-irq51 gated the buffer drain on Buffer Read Enable and the result did not move: LBA 1
# still read 0x4546492045464920 ("EFI " twice) at 1 MHz and at 4.2 MHz. A block that latches
# one word and hands it back 128 times is not a drain-rate problem: it is a data phase that
# never ran, and "EFI " is exactly the first word of the GPT header ABL reads when it scans
# partitions, i.e. leftovers from the bootloader's own read.
#
#   emmc_dma_phys  SDMA system address for the 512-byte block, so the controller writes to
#                  memory and the FIFO port is out of the picture;
#   qcom_emmc_bs   BLOCK_SIZE read back after writing it;
#   qcom_emmc_bc   BLOCK_COUNT read back;
#   qcom_emmc_dat  PRESENT_STATE bits 20..23 sampled right after CMD17 -- the DAT line
#                  levels; if they never move the card is not sending.
--- a/bsd/dev/qcom_emmc.c
+++ b/bsd/dev/qcom_emmc.c
@@ -96,6 +96,14 @@
  * the whole first eight bytes are carried instead of four. "EFI PART" reads
  * 0x4546492050415254; anything else says exactly how the block is misaligned. */
 volatile unsigned long long qcom_emmc_d1q;
+/* boot-irq52: bs/bc = BLOCK_SIZE/BLOCK_COUNT read back after writing, dat = DAT[3:0] line
+ * levels sampled right after CMD17, sdm = SDMA system address valid. */
+volatile unsigned int qcom_emmc_bs, qcom_emmc_bc, qcom_emmc_dat, qcom_emmc_sdm;
+/* boot-irq52: SDMA needs a physical address; pmap_kextract() is kernel-internal and the
+ * SDK copy of vm/pmap.h does not declare it, so it is declared here with a scalar
+ * signature, and the scratch address for the next data command lives here. */
+/* ml_static_vtop() (machine_routines) turns the kernel virtual address into a physical one. */
+static uint32_t emmc_dma_phys;
 #define BP_STAGE(text) do { if (boot_progress_stage) boot_progress_stage(text); qcom_emmc_stage = __LINE__; sirius_emmc_step = __LINE__; } while (0)
 
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
@@ -419,6 +427,8 @@
 		}
 		hc_wr16(SDHCI_BLOCK_SIZE, EMMC_BLOCK);
 		hc_wr16(SDHCI_BLOCK_COUNT, (uint16_t)blocks);
+		qcom_emmc_bs = hc_rd16(SDHCI_BLOCK_SIZE);
+		qcom_emmc_bc = hc_rd16(SDHCI_BLOCK_COUNT);
 		hc_wr16(SDHCI_TRANSFER_MODE,
 		    (uint16_t)(SDHCI_TM_READ | SDHCI_TM_BLKCNT_EN |
 		    (blocks > 1 ? SDHCI_TM_MULTI | SDHCI_TM_AUTO_CMD12 : 0)));
@@ -428,6 +438,9 @@
 	}
 	hc_wr(SDHCI_ARGUMENT, arg);
 	hc_wr16(SDHCI_COMMAND, SDHCI_CMD(idx, flags));
+	if (data) {
+		qcom_emmc_dat = (hc_rd(SDHCI_PRESENT_STATE) >> 20) & 0xfu;
+	}
 
 	qcom_emmc_lasterr = 0xC2u;
 	error = emmc_wait_int(SDHCI_INT_CMD_COMPLETE, deadline, 1);
@@ -956,7 +969,12 @@
 		uint32_t gr[4] = { 0, 0, 0, 0 };
 		unsigned gnz = 0;
 		int sig;
-		int rerr = emmc_cmd(17, 1u, /* READ_SINGLE_BLOCK, LBA 1 */
+		int rerr;
+		/* boot-irq52: SDMA move -- the FIFO port returned one word 128 times, so take the
+		 * controller's own DMA path into memory instead. */
+		emmc_dma_phys = (uint32_t)ml_static_vtop((addr64_t)(uintptr_t)gpt_blk);
+		qcom_emmc_sdm = emmc_dma_phys ? 1u : 0u;
+		rerr = emmc_cmd(17, 1u, /* READ_SINGLE_BLOCK, LBA 1 */
 		    SDHCI_CMD_RESP_R48 | SDHCI_CMD_CRC | SDHCI_CMD_INDEX | SDHCI_CMD_DATA,
 		    gr, gpt_blk, 1);
 		for (unsigned i = 0; i < sizeof(gpt_blk); i++) {
