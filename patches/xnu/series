# Board patch paths, one per line in application order.
#
# The OS profile series is deliberately not listed in board.toml: its
# zzz-boot-progress.patch has hunks against sheng_pmgr_run() and
# sheng_boot_watchdog_policy(), which only the SM8550 SoC patches provide. The
# board copy below keeps every other checkpoint of that patch.
#
# Keep the XnuPrelink patches here because dropping the OS series drops them too.
zzz-boot-progress.patch
# R11 eMMC root device: read-only SDHCI PIO block driver (bsd/dev/qcom_emmc.c)
# + vfs_mountroot probe assigning rootdev. Same shape as rmx1971's
# sweet-ufs-root.patch; see the patch header for the register map.
qcom-emmc-root.patch
# Let bsd_init reach vfs_mountroot instead of panicking in IOKitBSDInit.
zzz-no-root-media-panic.patch
# eMMC verdict globals + no bdevvp() panic when the probe fails.
zzz-emmc-verdict.patch
# Real sirius_emmc_* values: SDHCI identity registers + source-line checkpoints.
zzz-emmc-regs.patch
# Bounded SWRST_ALL wait + 8-bit CAPABILITIES base clock.
zzz-emmc-cmd.patch
# Enable the SD clock (bit 2) and record command failure status in h=.
zzz-emmc-clk.patch
# Enable SDHCI status enables (0x34/0x36) so polling can see completion/errors.
zzz-emmc-irq.patch
# Publish command error codes in h= and send CMD0 before the OCR loop.
zzz-emmc-cmd0.patch
# Keep the command error code in h=; targeted SWRST_CMD when CMD inhibit is stuck.
zzz-emmc-inh.patch
# qcom_emmc_lasterr: the command error status in its own word.
zzz-emmc-lasterr.patch
# CMD1 retries on a command timeout instead of ending the probe.
zzz-emmc-retry.patch
# Command probe matrix: which of CMD1/CMD13/CMD2/CMD9 the card answers.
zzz-emmc-probe.patch
# sdhci-msm v5 vendor offsets + default MCLK select in CORE_VENDOR_SPEC.
zzz-emmc-v5.patch
# Vendor registers are on the HC BAR, not the CQHCI range.
zzz-emmc-hc.patch
# Acknowledge the PMIC power-control handshake (pwrctl=).
zzz-emmc-pwr.patch
# Request bus power and complete the PMIC handshake before CMD0.
zzz-emmc-pwron.patch
# Probe CMD1 at 3.3 V, 3.0 V and 1.8 V bus voltage.
zzz-emmc-volt.patch
# Reset CORE_VENDOR_SPEC to its POR value (clears HS400 select-in) + publish RESPONSE.
zzz-emmc-por.patch
# Select the card (CMD7) before CMD6; fresh busy deadlines; report CMD7 error.
zzz-emmc-cmd7.patch
# CMD7 without busy (R48) + CMD13 status readback.
zzz-emmc-cmd13.patch
# Read EXT_CSD in 1-bit before switching width/timing; report each bus change.
zzz-emmc-extcsd.patch
# Wait-point markers so a timeout names the step (eeC0..eeC4).
zzz-emmc-marker.patch
# Tolerate a missing Transfer Complete on single-block PIO reads (SWRST_DAT + verify).
zzz-emmc-txc.patch
# Raise the card clock to 1 MHz before the first data transfer.
zzz-emmc-fastclk.patch
# CMD17 read of LBA 1 (GPT header) to prove the data path with a signature.
zzz-emmc-cmd17.patch
# CMD17/EXT_CSD results in plain globals, immune to stage drops.
zzz-emmc-numeric.patch
# LBA-0 read + first bytes of LBA 1, to identify the content and the addressing mode.
zzz-emmc-lba0.patch
# Eight-byte signature dump of the LBA-1 block.
zzz-emmc-d1q.patch
# 4 MHz data reads + SWRST_DAT before each CMD17.
zzz-emmc-clk4.patch
# Gate each PIO buffer read on PRESENT_STATE Buffer Read Enable.
zzz-emmc-bufrdy.patch
# SDMA block read + BLOCK_SIZE/COUNT readback + DAT line sample.
zzz-emmc-sdma2.patch
# boot-irq56: real SDMA (the address is written and DMA enabled, which irq52/54 never
# did) plus a PIO drain that waits for Transfer Complete, and a CMD13 after the data
# phase. 400 kHz block clock, no CMD6 bus-width switch.
zzz-emmc-sdma3.patch
# boot-irq57: SDHCI 4.x register layout, ported from E5's NativeEmmc: V4EN + 64-bit
# addressing (HC2=0x3000), 32-bit block count at 0x00, system address at 0x58/0x5c,
# explicit SDMA select, v4 10-bit clock divider; and no CMD6 width/HS switch (the
# validated E5 path reads the whole GPT in 1-bit default speed).
zzz-emmc-v4.patch
# boot-irq59: boot-irq58's warm CMD13+SDMA read black-screened on device, so this patch
# is read-only: it publishes the bootloader eMMC state (hc1/hc2/clk/ps/vspec) after the
# GCC gates are on, uses the boot HC2 layout, and then runs the ordinary re-identification.
zzz-emmc-bootstate.patch
# boot-irq61: black screen solved (irq60 kept EnableChargerWdog=0). The irq59 photo
# showed HC1=0x38 (8-bit + ADMA64), CLK=0x0007 (~100 MHz), VSPEC=0x240a0e (HS400
# select-in/DLL), so this patch keeps that state and makes one warm ADMA2 CMD17 read
# of LBA1: GCC gates first, no HC1/clock/POR write, no SWRST_DAT. EFI PART keeps the
# state and parses the GPT through ADMA2; otherwise the ordinary path runs.
zzz-emmc-warm-adma.patch
# boot-irq63: irq62 showed w=1/st=0 -- the card was not selected at CMD13. Send CMD7
# RCA1 (R48) before CMD13, then ADMA2; HC1=0x38/CLK/VSPEC untouched.
zzz-emmc-warm-cmd7.patch
# boot-irq65: irq64 w=2 (CMD7 RCA1 failed), irq55 PIO did not black, irq56+ SDMA did.
# Drop the normal-path SDMA LBA1 probe; first data command is PIO. Warm CMD7 remains
# diagnostic and is expected to fail while the card is unselected.
zzz-emmc-pio.patch
# boot-irq66: irq65 PIO-only did not black but still read "EFI EFI "/EXT_CSD zero; the card
# kept HS400 while the host was 1-bit. Clear HS_TIMING=0 first, then BUS_WIDTH=0, then PIO.
zzz-emmc-hsreset.patch
# boot-irq67: irq66 PIO still returned EFI EFI/EXT_CSD zero and hs0/bw1 scrolled out.
# Publish CMD6 HS_TIMING/BUS_WIDTH R1 + busy + error as c6=<hs>/<bw> on the EMMC2 row.
zzz-emmc-c6.patch
# boot-irq68: irq67 c6=00800900/00800900 = CMD6 accepted but DAT0 busy timed out at 200 ms;
# wait 2 s, stop before data on busy, then 1 ms settle.
zzz-emmc-c6wait.patch
# boot-irq69: irq68 showed HS_TIMING=0 accepted (c6 00000900) but BUS_WIDTH left CMD
# inhibit/init 60. Keep the card/host 8-bit, skip BUS_WIDTH, PIO at default speed.
zzz-emmc-8bit.patch
# boot-irq70: sirius shows vqmmc=1.8 V while the controller sat at 3.0 V; commands work,
# data doesn't. Our irq65-69 ran POWER_CONTROL=0x0f. Force 0x0b + HC2 bit3 before data.
zzz-emmc-18v.patch
# boot-irq71: irq70's late 1.8 V write was never reached because HS0 was busy at 3.3 V.
# Move 1.8 V before CMD7/CMD13/HS0 so the timing switch runs at the card I/O voltage.
zzz-emmc-18v-early.patch
# boot-irq83: skip the HS_TIMING/BUS_WIDTH switch entirely; after CMD0 the card is
# default 1-bit, host HC1=0, PHY 1.8 V, PIO read. HS0 busy was the blocker.
zzz-emmc-1bit-default.patch
# boot-irq84: warm RCA scan 1..8 (CMD13, then CMD7+CMD13), then PIO LBA1 in the
# inherited 8-bit/HS400 state; no 64-bit ADMA descriptor, no host reset.
zzz-emmc-warm-rca.patch
# boot-irq85: skip SWRST_ALL, which stays asserted on this unit and leaves the host
# half-reset; keep boot host state, then the normal CMD0..CMD7 1-bit path.
zzz-emmc-noswreset.patch
# boot-irq86: SDM660 SDCC has no internal divider; program GCC sdcc1_apps_clk_src
# to 400 kHz (clover CFG=0x2017 M=1 N=fc D=fb), and clear VENDOR_SPEC3 bit10
# (alt FIFO) which makes the buffer port return the first word forever.
zzz-emmc-gcc400.patch
# boot-irq87: irq86 hung before "clk 400k id"/v3; stop calling the GCC root-clock
# helper, keep the VENDOR_SPEC3 alt-FIFO clear, so the FIFO fix is tested alone.
zzz-emmc-fifo-only.patch
# boot-irq88: re-enable GCC 400k, but stop the card clock and RESET_CMD|DATA (0x06)
# first (clover mode 6); stages stop/rst/cfg/up/done.
zzz-emmc-gcc-safe.patch
# boot-irq89: skip the CORE_PWRCTL handshake/probe; clover sets 1.8 V and proceeds.
zzz-emmc-pwrskip.patch
# boot-irq90: after GCC root 400k, SDHCI divider must be 0 (clover), not the v3
# 249 field computed for a 200 MHz base; otherwise CMD1 is divided twice.
zzz-emmc-div0.patch
# boot-irq91: restore the CORE_PWRCTL handshake/probe; divider=0 did not make CMD1
# answer, so the card power is the remaining suspect.
zzz-emmc-pwrrestore.patch
# USB CDC serial parked (2026-11-08): STILL u=5 after reset/status/endpoint fixes.
# Files kept on disk for later: native-dwc3-console.patch, zzz-dwc3-*.patch.
# REJECTED, kept on disk: boot-irq58's warm-inherit CMD13+SDMA read (black screen).
#zzz-emmc-warm.patch
# REJECTED, kept on disk for reference and not in the series: boot-irq55 forced the card
# back to 1-bit with CMD6 before reading, on the theory that a card left in 8-bit mode
# by the previous boot was putting its bytes on the wrong lines. The reverse came back:
# LBA 1 read all zeros with EIO and LBA 0 timed out, so the switch broke a data phase
# that had at least been delivering the first word. The card is in 1-bit mode (an 8-bit
# card on a 1-bit host would not produce "EFI " at all), so the hypothesis is dead.
#zzz-emmc-1bit.patch
