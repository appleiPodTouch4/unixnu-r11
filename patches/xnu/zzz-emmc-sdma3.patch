 /* One command; response lands in su-resp words. data_len>0 = PIO read. */
 static int
 emmc_cmd(unsigned idx, uint32_t arg, uint16_t flags, uint32_t *resp,
@@ -464,6 +603,33 @@ emmc_cmd(unsigned idx, uint32_t arg, uint16_t flags, uint32_t *resp,
 		resp[3] = hc_rd(SDHCI_RESPONSE + 12);
 	}
 	if (data) {
+		/*
+		 * boot-irq56: for a single block, do not touch the data port until the whole
+		 * block is in the controller's buffer. irq50 and irq51 drained it right after
+		 * Buffer Read Ready and got the first word back 128 times ("EFI EFI "), which
+		 * is exactly what a port read returns once the buffer is empty: at 1 MHz a
+		 * word takes 32 us to arrive, while 128 CPU-paced port reads finish in a few
+		 * microseconds. Waiting for Transfer Complete removes the race; this host
+		 * reports a 4096-byte maximum block length, so a 512-byte block fits.
+		 * If the controller only raises Transfer Complete after the buffer has been
+		 * drained, the wait expires and the old drain-as-it-arrives path below runs
+		 * instead -- slower, but never a new dead end.
+		 */
+		if (blocks == 1) {
+			uint64_t tc = timeout_ns(300ull * NSEC_PER_MSEC);
+
+			error = emmc_wait_int(SDHCI_INT_TX_COMPLETE, tc, 1);
+			if (!error) {
+				uint32_t *out = (uint32_t *)data;
+
+				for (uint32_t w = 0; w < EMMC_BLOCK / 4; w++) {
+					out[w] = hc_rd(SDHCI_BUFFER);
+				}
+				qcom_emmc_lasterr = 0xCC02u;	/* drain-after-TC */
+				return 0;
+			}
+			qcom_emmc_lasterr = 0xC3u;
+		}
 		for (uint32_t b = 0; b < blocks; b++) {
 			uint32_t *out = (uint32_t *)(data + (uint64_t)b * EMMC_BLOCK);
 			qcom_emmc_lasterr = 0xC3u;
@@ -519,6 +685,24 @@ emmc_read_blocks(uint64_t lba, uint32_t count, uint8_t *buf)
 {
 	int error;
 
+	/*
+	 * boot-irq56: once CMD17 has completed through the DMA engine, keep using it. One
+	 * command per block is slower than a CMD18 burst, but it needs no assumption about
+	 * the caller's buffer being physically contiguous: emmc_sdma_read bounces each
+	 * block through its own page-aligned landing zone and memcpy's it out.
+	 */
+	if (su.dma) {
+		while (count) {
+			error = emmc_sdma_read(17, (uint32_t)lba, buf);
+			if (error) {
