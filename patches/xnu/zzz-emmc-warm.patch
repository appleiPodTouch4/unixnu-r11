+		BP_STAGE("emmc: warm gpt");
+		lck_mtx_lock(&qcom_emmc_lock);
+		error = emmc_find_partition(want);
+		lck_mtx_unlock(&qcom_emmc_lock);
+		if (!error) {
+			goto have_partition;
+		}
