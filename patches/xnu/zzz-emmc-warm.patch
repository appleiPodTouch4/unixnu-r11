+	 * boot-irq57 tried to force the host into SDHCI 4.x here (HC2 = 0x3000).
+	 * boot-irq57's own photo showed the bootloader had left HC2 = 0x0003
+	 * (V4EN clear), and after the forced write every data phase timed out while
+	 * CMD13/CMD8 command phases still worked. So this host is a v3 layout in
+	 * practice; use the boot value instead of forcing V4EN. The v4 register
+	 * branches stay for a host that really boots with V4EN set, but they are
+	 * selected by the readback, not by this driver's wish.
 	 */
-	hc_wr16(SDHCI_HOST_CONTROL2, SDHCI_HC2_V4EN | SDHCI_HC2_64BIT);
 	{
 		uint16_t hc2 = hc_rd16(SDHCI_HOST_CONTROL2);
 
@@ -1626,6 +1726,32 @@ qcom_emmc_init(void)
 	sirius_emmc_state = hc_rd(SDHCI_PRESENT_STATE);
 	sirius_emmc_clock = hc_rd16(SDHCI_CLOCK_CONTROL);
 	sirius_emmc_power = hc_rd8(0x29);	/* Power Control: no macro in this file */
+	/*
+	 * boot-irq58: warm-inherit path first.  E5's NativeEmmc reads LBA1 in the
+	 * bootloader's live state (CMD13 + SDMA) before re-identifying, because the
+	 * full reset/POR/power sequence destroys the vendor DLL and bus state the
+	 * bootloader had already set up for its own eMMC reads.  If this read
+	 * delivers EFI PART, keep that state, parse the GPT and never touch
