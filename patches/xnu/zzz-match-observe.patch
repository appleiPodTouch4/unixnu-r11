-	registerService(kIOServiceSynchronous);
+	unsigned r11_async = 0;
+	PE_parse_boot_argn("r11-root-async", &r11_async, sizeof(r11_async));
+	if (r11_async) {
+		if (boot_progress_stage) boot_progress_stage("root: registerService async");
+		registerService();
+	} else {
+		if (boot_progress_stage) boot_progress_stage("root: registerService sync");
+		registerService(kIOServiceSynchronous);
+	}
 	if (boot_progress_stage) boot_progress_stage("root: registerService done");
 
 	return true;
