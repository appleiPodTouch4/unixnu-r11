# R11: probe the card at each SDHCI bus voltage before believing it is dead.
#
# boot-irq33 completed the PMIC handshake: requesting bus power at 3.3 V made the
# PMIC report CORE_PWRCTL_BUS_ON, which the driver acknowledged, so the power path
# does react to what the AP asks for. The card still answered nothing, and the bus
# had been left at 1.8 V -- the voltage this board uses for vqmmc, while its vmmc
# is 2.95 V.
#
# The SDHCI bus-voltage field is what the PMIC follows, so this patch walks 3.3 V,
# 3.0 V and 1.8 V, issuing CMD0 and a single CMD1 at each, and records which voltage
# (if any) the card answered. The mask is published in the high byte of pwrctl=.
# If none of the three works, then the card has power, has a clock, and still does
# not respond -- and the defect is in the card-side initialisation rather than in
# power or clocks.
--- a/bsd/dev/qcom_emmc.c
+++ b/bsd/dev/qcom_emmc.c
@@ -651,6 +651,35 @@
 		}
 		sirius_emmc_pwrctl = packed;
 		BP_STAGE((packed & 0xfu) ? "emmc: pwr bus_on" : "emmc: pwr no event");
+
+		/*
+		 * boot-irq34: the 3.3 V request raised BUS_ON and was acknowledged, so the
+		 * PMIC does switch the bus -- yet the card stayed mute with the bus left at
+		 * 1.8 V. This board's vmmc is 2.95 V and its vqmmc is 1.8 V, and the SDHCI
+		 * bus-voltage field is what the PMIC follows, so try CMD1 at 3.3 V, 3.0 V and
+		 * 1.8 V in turn and record which one (if any) the card answers. The mask lands
+		 * in the high byte of pwrctl= so a single photograph separates them.
+		 */
+		{
+			static const uint8_t kProbePwr[3] = { 0x0fu, 0x0du, 0x0bu };
+			uint32_t r[4];
+			unsigned pwr_mask = 0;
+			for (unsigned v = 0; v < 3; v++) {
+				hc_wr8(SDHCI_HOST_CONTROL + 1, kProbePwr[v]);
+				delay(20000);	/* 20 ms for the rail to settle */
+				hc_wr8(SDHCI_SOFTWARE_RESET, 0x02u);
+				delay(1000);
+				(void)emmc_cmd(0, 0, SDHCI_CMD_RESP_NONE, NULL, NULL, 0);
+				if (!emmc_cmd(1, 0x40ff8080u, SDHCI_CMD_RESP_R48, r, NULL, 0)) {
+					pwr_mask |= (1u << v);
+					su.ocr = r[0];
+					break;
+				}
+				hc_wr8(SDHCI_SOFTWARE_RESET, 0x02u);
+			}
+			sirius_emmc_pwrctl = (sirius_emmc_pwrctl & 0xffu) | (pwr_mask << 8);
+			BP_STAGE(pwr_mask ? "emmc: pwr volt hit" : "emmc: pwr volt none");
+		}
 	}
 
