+// Text only, no panel stage: a stage would take the panel lock and repaint,
+// which is itself a way to lose the evidence if an interrupt lands inside it.
+static void r11SubStep (unsigned step)
+{
+  armcpu_sub_step = step;
+  if (boot_progress_substep_text != nullptr) { boot_progress_substep_text (step); }
+}
+static void r11StartStep (unsigned step)
+{
+  armcpu_start_step = step;
+  if (boot_progress_step_blip != nullptr) { boot_progress_step_blip (step); }
+  if (boot_progress_step_text != nullptr) { boot_progress_step_text (step); }
+  if (boot_progress_stage != nullptr) {
+    // No snprintf in the kext: build "start step 0xNN" by hand.
+    char t[24];
+    unsigned i = 0;
+    const char *pre = "start step 0x";
+    while (*pre != 0 && i < 20) { t[i++] = *pre++; }
+    unsigned digits = 0;
+    for (int shift = 12; shift >= 0; shift -= 4) {
+      unsigned nibble = (step >> shift) & 0xFU;
+      if (nibble != 0) { digits = 1; }
+      if (digits != 0) { t[i++] = static_cast<char> (nibble < 10 ? ('0' + nibble) : ('a' + nibble - 10)); }
+    }
+    if (digits == 0) { t[i++] = '0'; }
+    t[i] = 0;
+    boot_progress_stage (t);
+  }
+}
