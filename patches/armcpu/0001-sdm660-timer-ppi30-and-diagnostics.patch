+//      perspective error -- good for "somewhere around step 9", not for which)
+//   3. the literal hex step, drawn as text next to the blocks, and a stage line,
+//      so the number can be read instead of measured.
+// All three live in the boot-progress package; weak so a build without the panel
+// still links, with the call sites checking for presence. Declared here because
+// r11StartStep is defined before the rest of the file's externs.
+extern "C" void boot_progress_step_blip (unsigned step) __attribute__((weak_import));
+extern "C" void boot_progress_step_text (unsigned step) __attribute__((weak_import));
+extern "C" void boot_progress_substep_text (unsigned step) __attribute__((weak_import));
+extern "C" void boot_progress_stage (const char *text) __attribute__((weak_import));
+// "About to run X" marker inside initCPU(). Written before the call, so the
+// number on screen names the call that never returned.
+// Default path (boot-irq11 on): 0x21 enableGic, 0x28 setCPUState, 0x29 the
+// first enableCPUTimeBase(true), 0x2A about to return to start().
+// armcpu-init-diag=1 adds the old observation tail between 0x21 and 0x28:
+// 0x22 enableCPUTimeBase(true), 0x23 enableCPUTimeBase(false), 0x24 the SGI
