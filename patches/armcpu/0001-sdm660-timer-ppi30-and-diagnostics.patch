+// Does the entry carry `want` in its NUL-separated compatible list?
+static bool r11CompatibleHas (IORegistryEntry *entry, const char *want)
+{
+  OSData *compatible = OSDynamicCast (OSData, entry->getProperty ("compatible"));
+  if (compatible == nullptr) { return false; }
+  const char *chars = static_cast<const char *> (compatible->getBytesNoCopy ());
+  unsigned length = compatible->getLength ();
+  unsigned wanted = static_cast<unsigned> (strlen (want));
+  for (unsigned index = 0; index < length;) {
+    unsigned size = 0;
+    while ((index + size) < length && chars[index + size] != 0) { size++; }
+    if ((size == wanted) && (memcmp (chars + index, want, size) == 0)) { return true; }
+    index += size + 1;
+  }
+  return false;
+}
